# ---------------------------------------------------------------------------
# PMI UAE AGM 2026 — Interactive Quiz
#
#   ⚠  THIS FILE IS A TEMPLATE AND IS COMMITTED TO A PUBLIC REPOSITORY.
#      Leave every value BLANK. Never type a real key, token or URL here.
#
#   For local development:   cp .env.example .env    then fill in .env
#   (.env is gitignored and will never be committed.)
#
#   For production, set these in:
#      Netlify → Site configuration → Environment variables
# ---------------------------------------------------------------------------

# --- Supabase (Settings → API Keys) ----------------------------------------
# Project URL, found under Settings → Data API.
# Example shape: https://abcdefghijkl.supabase.co
SUPABASE_URL=

# The SECRET key, from Settings → API Keys → "Secret keys" (starts sb_secret_).
# Click the eye icon to reveal it before copying.
#
# This replaces the old `service_role` key — Supabase changed the key system in
# 2025. If your project still shows legacy keys, the service_role JWT under the
# "Legacy anon, service_role API keys" tab works identically.
#
# Do NOT use the publishable key (sb_publishable_...). It cannot bypass row
# level security, and every table in this schema denies anon outright. The app
# refuses to start if a publishable key is supplied.
#
# Server-side ONLY — never sent to the browser, never bundled by Vite.
SUPABASE_SECRET_KEY=

# Legacy fallback. Only set this if your project predates the new key system.
SUPABASE_SERVICE_ROLE_KEY=

# --- Game control ----------------------------------------------------------
# Long random string gating /host and /admin. Generate one with:
#     openssl rand -hex 24
#
# Treat this like a password. Anyone holding it can drive the live game AND
# export the full delegate contact list. Keep it OUT of this file.
HOST_TOKEN=

# The session the host screen and players bind to on event day.
GAME_CODE=AGM2026

# --- Optional tuning -------------------------------------------------------
# Seconds each question stays open. Run-of-show assumes 15.
QUESTION_DURATION_SECONDS=15

# Number of goodie winners. Configurable 3–10; final count confirmed by PMI.
WINNER_COUNT=5

# Extra milliseconds of grace for an answer sent before the timer expired but
# delayed by a congested venue network.
LATE_ANSWER_GRACE_MS=2500
