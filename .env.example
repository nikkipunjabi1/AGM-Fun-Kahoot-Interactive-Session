# ---------------------------------------------------------------------------
# PMI UAE AGM 2026 — Interactive Quiz
# Copy to `.env` for local dev, and set the same keys in Netlify:
#   Netlify → Site configuration → Environment variables
#
# NEVER commit a real .env — this GitHub repository is PUBLIC.
# ---------------------------------------------------------------------------

# --- Supabase (Project Settings → API) -------------------------------------
# Project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=https://yixlyhwjaxlagytogtmo.supabase.co

# service_role key. Server-side ONLY. Used exclusively inside Netlify
# Functions — it is never sent to the browser and never bundled by Vite.
SUPABASE_SERVICE_ROLE_KEY=

# --- Game control ----------------------------------------------------------
# Long random string. Required to open /host and /admin and to send any
# host action. Generate one with:  openssl rand -hex 24
HOST_TOKEN=1404af8219501c3bc43f0e68c5713a520edcfa2c868959b6

# The session the host screen and players will bind to on event day.
GAME_CODE=AGM2026

# --- Optional tuning -------------------------------------------------------
# Seconds each question stays open. Run-of-show assumes 15.
QUESTION_DURATION_SECONDS=15

# Number of goodie winners. Configurable 3–10; final count confirmed by PMI.
WINNER_COUNT=5

# Extra milliseconds of grace allowed for an answer that was sent before the
# timer expired but arrived late over a congested venue network.
LATE_ANSWER_GRACE_MS=2500
